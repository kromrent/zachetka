{
  "name": "exam-trainer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts",
    "start": "tsx server/index.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "extract:pdf": "node tools/extract-pdf.mjs",
    "build:bank": "tsx tools/build-question-bank.ts"
  },
  "dependencies": {
    "@tesseract.js-data/rus": "^1.0.0",
    "@types/pg": "^8.20.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.0",
    "ffmpeg-static": "^5.3.0",
    "helmet": "^8.3.0",
    "openai": "^6.48.0",
    "pdfjs-dist": "^5.4.149",
    "pg": "^8.22.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tesseract.js": "^7.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^10.0.3",
    "tsx": "^4.23.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.4",
    "vite-plugin-pwa": "^1.0.3"
  }
}
