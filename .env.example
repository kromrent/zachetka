# Создай рядом файл .env и вставь ключ. Никогда не добавляй .env в git.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5.6-luna
OPENAI_TTS_MODEL=gpt-4o-mini-tts
PORT=8787

# Локальная компиляция Java проверяет только синтаксис. На публичном сервере оставь false.
ENABLE_LOCAL_JAVA=false

# Для Telegram Mini App: токен бота из BotFather. Не публикуй его.
TELEGRAM_BOT_TOKEN=

# Локально Postgres.app; на хостинге замени на выданный PostgreSQL URL.
DATABASE_URL=postgresql://postgres@127.0.0.1:5432/zachetka
DATABASE_SSL=false
